# App Store Connect uploads for 버스온다 (iOS).
#
# Auth: the personal team's App Store Connect API key, outside the repo:
#   source ~/.appstoreconnect/env.sh   (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH)
# The Xcode project is generated by Tuist first: mise x -- tuist generate --no-open
#
#   fastlane info       # app record, versions and recent builds
#   fastlane beta       # Release-Prod archive -> TestFlight with "What to Test"
#   fastlane metadata   # 1.0.x "What's New" + review notes only (no screenshots, never submits)
default_platform(:ios)

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: File.expand_path(ENV.fetch('ASC_KEY_PATH'))
    )
  end

  desc 'Show the app record, its versions and recent builds'
  lane :info do
    api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!('App not found for this API key') unless app
    UI.message("app: #{app.name} id=#{app.id} primary=#{app.primary_locale}")
    app.get_app_store_versions.each { |v| UI.message("version #{v.version_string} #{v.app_store_state}") }
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: '-uploadedDate', limit: 8).each do |b|
      UI.message("build #{b.app_version} (#{b.version}) #{b.processing_state}")
    end
  end

  desc 'Release-Prod archive (personal team, automatic signing) -> TestFlight with "What to Test"'
  lane :beta do
    key = api_key
    plist = File.expand_path('../Derived/InfoPlists/버스온다-Info.plist', __dir__)
    build_number = get_info_plist_value(path: plist, key: 'CFBundleVersion') if File.exist?(plist)
    version = '1.0.4'
    latest = latest_testflight_build_number(api_key: key, version: version, initial_build_number: 0)
    UI.user_error!("CFBundleVersion #{build_number} must be above #{latest}; bump it in Project.swift") if build_number && build_number.to_i <= latest
    build_app(
      workspace: '버스온다.xcworkspace',
      scheme: '버스온다',
      configuration: 'Release-Prod',
      export_method: 'app-store',
      output_directory: 'build',
      output_name: 'busonda',
      xcargs: ['-allowProvisioningUpdates',
               "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH'))}",
               "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
               "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
               'DEVELOPMENT_TEAM=RK3JJD2BZC', 'CODE_SIGN_STYLE=Automatic'].join(' ')
    )
    upload_to_testflight(
      api_key: key,
      changelog: File.read(File.expand_path('what_to_test.txt', __dir__)),
      distribute_external: false
    )
  end

  desc 'Upload 1.0.4 "What\'s New" and review notes only (no screenshots, never submits)'
  lane :metadata do
    deliver(
      api_key: api_key,
      app_version: '1.0.4',
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end
end
